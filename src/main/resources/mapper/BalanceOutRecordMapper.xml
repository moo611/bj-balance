<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.balance.mapper.BalanceOutRecordMapper">

    <resultMap type="com.example.balance.domain.BalanceOutRecord" id="BalanceOutRecordResult">
        <result property="id"    column="id"    />
        <result property="balanceCode"    column="balance_code"    />
        <result property="balanceName"    column="balance_name"    />
        <result property="wholeName"    column="whole_name"    />
        <result property="pName"    column="p_name"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="wholeCode"    column="whole_code"    />
    </resultMap>

    <sql id="selectBalanceOutRecordVo">
        select id,
               balance_code,
               whole_name,
               p_name,
               del_flag,
               create_time,
               create_by,
               update_time,
               update_by,
               whole_code
        from balance_out_record
    </sql>

    <select id="selectBalanceOutRecordList" parameterType="com.example.balance.domain.BalanceOutRecord" resultMap="BalanceOutRecordResult">
        select a.id, a.balance_code,b.balance_name, a.whole_name, a.p_name, a.del_flag, a.create_time, a.create_by, a.update_time, a.update_by,a.whole_code from balance_out_record a
        left join balance_info b on a.balance_code=b.balance_code
        <where>a.del_flag='0'
            <if test="balanceCode != null  and balanceCode != ''"> and a.balance_code = #{balanceCode}</if>
            <if test="wholeName != null  and wholeName != ''"> and a.whole_name like concat('%', #{wholeName}, '%')</if>
            <if test="pName != null  and pName != ''"> and a.p_name like concat('%', #{pName}, '%')</if>
        </where>
        order by a.create_time desc
    </select>

    <select id="selectBalanceOutRecordById" parameterType="long" resultMap="BalanceOutRecordResult">
        <include refid="selectBalanceOutRecordVo"/>
        where del_flag='0' and id = #{id}
    </select>

    <insert id="insertBalanceOutRecord" parameterType="com.example.balance.domain.BalanceOutRecord" useGeneratedKeys="true" keyProperty="id">
        insert into balance_out_record
        <trim prefix="(" suffix=")" suffixOverrides=",">

            <if test="balanceCode != null">balance_code,</if>
            <if test="wholeName != null">whole_name,</if>
            <if test="pName != null">p_name,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="wholeCode != null">whole_code,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">

            <if test="balanceCode != null">#{balanceCode},</if>
            <if test="wholeName != null">#{wholeName},</if>
            <if test="pName != null">#{pName},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="wholeCode != null">#{wholeCode},</if>
        </trim>
    </insert>

    <update id="updateBalanceOutRecord" parameterType="com.example.balance.domain.BalanceOutRecord">
        update balance_out_record
        <trim prefix="SET" suffixOverrides=",">
            <if test="balanceCode != null">balance_code = #{balanceCode},</if>
            <if test="wholeName != null">whole_name = #{wholeName},</if>
            <if test="pName != null">p_name = #{pName},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="wholeCode != null">whole_code = #{wholeCode},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteBalanceOutRecordById" parameterType="long">
        update balance_out_record set del_flag='2' where id = #{id}
    </delete>

    <delete id="deleteBalanceOutRecordByIds" parameterType="long">
        update balance_out_record set del_flag='2' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <select id="countBalanceOutRecord" parameterType="string" resultType="int">
        select count(*) from balance_out_record where del_flag='0' and balance_code = #{balanceCode}
    </select>


</mapper>