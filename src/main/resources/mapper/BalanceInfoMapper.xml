    <sql id="selectBalanceInfoVo">
        select balance_code,balance_name, balance_type, balance_classify, balance_material, balance_support, balance_inferface, balance_designer, balance_dtime, balance_factory, balance_ftime, balance_x, balance_y, balance_z, balance_mx, balance_my, balance_mz, balance_tnum, balance_state, del_flag, create_time, create_by, update_time, update_by,status from balance_info
    </sql>

    <select id="selectBalanceInfoList" parameterType="com.example.balance.domain.BalanceInfo" resultMap="BalanceInfoResult">
        <include refid="selectBalanceInfoVo"/>
        <where>del_flag='0'
            <if test="balanceType != null  and balanceType != ''"> and balance_type = #{balanceType}</if>
            <if test="balanceClassify != null  and balanceClassify != ''"> and balance_classify = #{balanceClassify}</if>
            <if test="balanceMaterial != null  and balanceMaterial != ''"> and balance_material = #{balanceMaterial}</if>
            <if test="balanceSupport != null "> and balance_support = #{balanceSupport}</if>
            <if test="balanceInferface != null  and balanceInferface != ''"> and balance_inferface = #{balanceInferface}</if>
            <if test="balanceDesigner != null  and balanceDesigner != ''"> and balance_designer = #{balanceDesigner}</if>
            <if test="balanceDtime != null "> and balance_dtime = #{balanceDtime}</if>
            <if test="balanceFactory != null  and balanceFactory != ''"> and balance_factory = #{balanceFactory}</if>
            <if test="balanceFtime != null "> and balance_ftime = #{balanceFtime}</if>
            <if test="balanceX != null "> and balance_x = #{balanceX}</if>
            <if test="balanceY != null "> and balance_y = #{balanceY}</if>
            <if test="balanceZ != null "> and balance_z = #{balanceZ}</if>
            <if test="balanceMx != null "> and balance_mx = #{balanceMx}</if>
            <if test="balanceMy != null "> and balance_my = #{balanceMy}</if>
            <if test="balanceMz != null "> and balance_mz = #{balanceMz}</if>
            <if test="balanceTnum != null "> and balance_tnum = #{balanceTnum}</if>
            <if test="balanceState != null  and balanceState != ''"> and balance_state = #{balanceState}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectBalanceInfoByBalanceCode" parameterType="string" resultMap="BalanceInfoResult">
        <include refid="selectBalanceInfoVo"/>
        where del_flag='0' and balance_code = #{balanceCode}
    </select>

    <select id="selectBalanceInfoVOList" resultMap="BalanceInfoResultVO">
        select bi.balance_code,bi.balance_name, bi.balance_type, bi.balance_classify, bi.balance_material, bi.balance_support, bi.balance_inferface, bi.balance_designer, bi.balance_dtime, bi.balance_factory, bi.balance_ftime, bi.balance_x, bi.balance_y, bi.balance_z, bi.balance_mx, bi.balance_my, bi.balance_mz, bi.balance_tnum, bi.balance_state, bi.del_flag, bi.create_time,
               bi.create_by, bi.update_time, bi.update_by,bi.status,bz.size_x,bz.size_y,bz.size_z from balance_info bi
        left join balance_size bz on bi.balance_code = bz.balance_code
        where bi.del_flag='0'

    </select>

