    <delete id="deleteBalanceInfoByBalanceCode" parameterType="string">
        update balance_info set del_flag='2' where balance_code = #{balanceCode}
    </delete>

    <delete id="deleteBalanceInfoByBalanceCodes" parameterType="string">
        update balance_info set del_flag='2' where balance_code in
        <foreach item="balanceCode" collection="array" open="(" separator="," close=")">
            #{balanceCode}
        </foreach>
