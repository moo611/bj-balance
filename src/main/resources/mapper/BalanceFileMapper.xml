<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.balance.mapper.BalanceFileMapper">

    <resultMap type="com.example.balance.domain.BalanceFile" id="BalanceFileResult">
        <result property="id"    column="id"    />
        <result property="fileName"    column="file_name"    />
        <result property="fileType"    column="file_type"    />
        <result property="filePath"    column="file_path"    />
        <result property="fileBelong"    column="file_belong"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="createTime"    column="create_time"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="balanceCode" column="balance_code"/>
    </resultMap>

    <sql id="selectBalanceFileVo">
        select id, file_name, file_type, file_path, file_belong, del_flag, create_time, create_by, update_time, update_by,balance_code from balance_file
    </sql>

    <select id="selectBalanceFileList" parameterType="com.example.balance.domain.BalanceFile" resultMap="BalanceFileResult">
        <include refid="selectBalanceFileVo"/>
        <where>del_flag='0'
            <if test="balanceCode != null  and balanceCode != ''"> and balance_code = #{balanceCode}</if>
            <if test="fileName != null  and fileName != ''"> and file_name like concat('%', #{fileName}, '%')</if>
            <if test="fileType != null  and fileType != ''"> and file_type = #{fileType}</if>
            <if test="filePath != null  and filePath != ''"> and file_path = #{filePath}</if>
            <if test="fileBelong != null  and fileBelong != ''"> and file_belong = #{fileBelong}</if>
        </where>
    </select>

    <select id="selectBalanceFileById" parameterType="long" resultMap="BalanceFileResult">
        <include refid="selectBalanceFileVo"/>
        where del_flag='0' and id = #{id}
    </select>

    <insert id="insertBalanceFile" parameterType="com.example.balance.domain.BalanceFile" useGeneratedKeys="true" keyProperty="id">
        insert into balance_file
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="fileName != null">file_name,</if>
            <if test="fileType != null">file_type,</if>
            <if test="filePath != null">file_path,</if>
            <if test="fileBelong != null">file_belong,</if>
            <if test="delFlag != null">del_flag,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createBy != null">create_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="balanceCode != null">balance_code,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="fileName != null">#{fileName},</if>
            <if test="fileType != null">#{fileType},</if>
            <if test="filePath != null">#{filePath},</if>
            <if test="fileBelong != null">#{fileBelong},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="balanceCode != null">#{balanceCode},</if>
        </trim>
    </insert>

    <update id="updateBalanceFile" parameterType="com.example.balance.domain.BalanceFile">
        update balance_file
        <trim prefix="SET" suffixOverrides=",">
            <if test="fileName != null">file_name = #{fileName},</if>
            <if test="fileType != null">file_type = #{fileType},</if>
            <if test="filePath != null">file_path = #{filePath},</if>
            <if test="fileBelong != null">file_belong = #{fileBelong},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="balanceCode != null">balance_code = #{balanceCode},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteBalanceFileById" parameterType="long">
        update balance_file set del_flag='2' where id = #{id}
    </delete>

    <delete id="deleteBalanceFileByIds" parameterType="long">
        update balance_file set del_flag='2' where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>